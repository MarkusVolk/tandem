[Unit]
Description=Tandem phone integration
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=dbus
BusName=@APP_ID@
ExecStart=@BINDIR@/tandem --gapplication-service
Restart=on-failure
Slice=app.slice

[Install]
WantedBy=graphical-session.target

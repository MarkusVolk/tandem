tandem_sources = files(
  'main.c',
  'app.c',
  'config.c',
  'cert.c',
  'packet.c',
  'util.c',
  'link.c',
  'handshake.c',
  'lan.c',
  'device.c',
  'manager.c',
  'plugin.c',
  'notify.c',
  'transfer.c',
  'sni.c',
  'plugins/ping.c',
  'plugins/battery.c',
  'plugins/connectivity.c',
  'plugins/findmyphone.c',
  'plugins/lock.c',
  'plugins/runcommand.c',
  'plugins/notifications.c',
  'plugins/share.c',
  'dbus-api.c',
  'cli.c',
  'smoke.c',
  'ui/window.c',
  'ui/device-page.c',
)

tandem_deps = [
  glib_dep,
  gio_dep,
  gio_unix_dep,
  json_dep,
  gtk_dep,
  adw_dep,
  gnutls_dep,
  pulse_dep,
  wayland_dep,
  xkb_dep,
  gst_dep,
  m_dep,
  protocols_dep,
]

executable('tandem',
  tandem_sources,
  dependencies: tandem_deps,
  include_directories: [config_inc, include_directories('.')],
  install: true,
)
